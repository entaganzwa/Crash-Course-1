<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 Not Found</title>
  <style>
    /* Fonts */
    h1, h2 {
      font-family: "Century Gothic", "Arial", sans-serif;
    }
    body, p, a {
      font-family: "Helvetica", "Arial", sans-serif;
    }

    /* Layout */
    body {
      margin: 0;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #ffffff; /* White background */
      color: #000;
      text-align: center;
      padding: 1rem;
    }
    .container {
      max-width: 700px;
      padding: 2rem;
    }

    /* Logo */
    .logo {
      margin-bottom: 1.5rem;
      margin-left: 1.5rem;
    }
    .logo img {
      max-width: 280px;
      height: auto;
    }

    /* Headings */
    h1 {
      font-size: 7rem;
      margin: 0;
      color: #de0000; /* Bright Blue */
      animation: float 3s ease-in-out infinite;
    }
    h2 {
      font-size: 2rem;
      margin: 1rem 0;
      color: #002984; /* Dark Blue */
    }

    /* Body text */
    p {
      font-size: 1.1rem;
      margin-bottom: 1.5rem;
      line-height: 1.6;
      color: #000;
    }

    /* CTA Button */
    a.cta {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: #179142; /* Bright Green */
      color: #fff;
      font-weight: bold;
      text-decoration: none;
      border-radius: 30px;
      transition: all 0.3s ease;
    }
    a.cta:hover {
      background: #FA7900; /* Bright Orange */
      transform: translateY(-3px);
    }

    /* Inline link styling */
    a.inline-link {
      color: #0076DE;
      text-decoration: underline;
    }

    /* Animation */
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-15px); }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo">
       <a href="https://maps.disasters.nasa.gov">
      <img src="/disasters-logo.jpeg" alt="NASA Disasters Logo">
      </a>
    </div>
    <h1>404</h1>
    <h2>Page Not Found</h2>
    <p>The page or resource you're looking for has been moved or no longer exists.</p>
    <p>Please visit the <strong>NASA Disasters Portal</strong> homepage at 
      <a href="https://disasters-nasa.hub.arcgis.com" class="inline-link">
        maps.disasters.nasa.gov
      </a> 
      to continue exploring NASA Disasters Program maps and data.
    </p>
    <a href="https://maps.disasters.nasa.gov" class="cta">Return to Portal</a>
  </div>
</body>
</html>
